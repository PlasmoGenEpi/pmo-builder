# Copy to .env.local for local builds. Never commit .env files.

# Where the app sends anonymous usage counts. Leave empty to send nothing,
# which is the default. Must be https. The build adds this URL's origin, and
# no other, to the Content Security Policy. Read docs/analytics.md first.
VITE_ANALYTICS_URL=

# The Zenodo community that PMO files are published to, as the identifier in
# zenodo.org/communities/<identifier>. Leave empty to hide the "Publish to
# Zenodo" panel on the review step.
VITE_ZENODO_COMMUNITY=

# What to call that community on screen. Default: the identifier.
VITE_ZENODO_COMMUNITY_NAME=

# The Client ID of an application registered with Zenodo (client type Public,
# redirect URI <app address>/zenodo-callback.html). With it the panel can sign
# the user in and prepare a draft, and the build allows https://zenodo.org in
# the Content Security Policy. Leave empty and the panel only guides the user
# through uploading by hand, and the app sends nothing to Zenodo.
VITE_ZENODO_CLIENT_ID=
