          "const": "visit"
        },
        "app": {
          "type": "string",
          "pattern": "^(unknown|[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4})$"
        }
      },
      "required": ["v", "kind", "app"],
      "additionalProperties": false
    },
